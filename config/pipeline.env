# Bash/SLURM pipeline configuration.

SAMPLE_SHEET="config/samples.tsv"

REFERENCE_FASTA="resources/reference/IRGSP-1.0_genome.fasta"
PANEL_FULL_TEMPLATE="resources/reference/hybrid_reference_{chrom}_addACAN.bcf"
PANEL_SITES_TSV_TEMPLATE="resources/reference/hybrid_reference_{chrom}.sites.tsv.gz"
MAP_TEMPLATE="resources/map/rice_genetic_{chrom}.map"

CHROMS=(
    "chr01"
    "chr02"
    "chr03"
    "chr04"
    "chr05"
    "chr06"
    "chr07"
    "chr08"
    "chr09"
    "chr10"
    "chr11"
    "chr12"
)

FASTP_EXTRA=""

GLIMPSE_CHUNK_WINDOW_SIZE=2000000
GLIMPSE_CHUNK_BUFFER_SIZE=200000
GLIMPSE_CHUNK_EXTRA=""

SLURM_ACCOUNT="rlchen"
SLURM_PARTITION="normal,fat"
SLURM_OUTPUT_DIR="logs/slurm"

SUBMIT_CPUS=1
SUBMIT_MEM="1000M"
SUBMIT_TIME="01:00:00"

REFERENCE_CPUS=1
REFERENCE_MEM="12000M"
REFERENCE_TIME="04:00:00"

TRIM_CPUS=8
TRIM_MEM="4000M"
TRIM_TIME="12:00:00"
TRIM_ARRAY_LIMIT=200

ALIGN_CPUS=16
ALIGN_MEM="24000M"
ALIGN_TIME="24:00:00"
ALIGN_ARRAY_LIMIT=200

COMPUTE_GL_CPUS=2
COMPUTE_GL_MEM="4000M"
COMPUTE_GL_TIME="12:00:00"
COMPUTE_GL_ARRAY_LIMIT=600

CONCAT_GL_CPUS=2
CONCAT_GL_MEM="2000M"
CONCAT_GL_TIME="06:00:00"
CONCAT_GL_ARRAY_LIMIT=200

MERGE_GL_CPUS=4
MERGE_GL_MEM="4000M"
MERGE_GL_TIME="12:00:00"
MERGE_GL_ARRAY_LIMIT=12

CHUNK_CPUS=1
CHUNK_MEM="2000M"
CHUNK_TIME="04:00:00"
CHUNK_ARRAY_LIMIT=12

PHASE_CPUS=16
PHASE_MEM="16000M"
PHASE_TIME="24:00:00"
PHASE_ARRAY_LIMIT=600

LIGATE_CPUS=4
LIGATE_MEM="8000M"
LIGATE_TIME="12:00:00"
LIGATE_ARRAY_LIMIT=12

CONCAT_IMPUTED_CPUS=4
CONCAT_IMPUTED_MEM="8000M"
CONCAT_IMPUTED_TIME="12:00:00"
